[Unit]
Description=Send a privacy-safe SkyScope snapshot
After=network-online.target readsb.service
Wants=network-online.target

[Service]
Type=oneshot
User=noel
Group=noel
EnvironmentFile=/etc/skyscope/exporter.env
ExecStart=/usr/bin/python3 /opt/skyscope/exporter.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
